    "sanity:seed:example": "node scripts/seed-example-db.mjs --write",
    "sanity:seed:block-showcase": "node scripts/seed-sanity-blocks-showcase-page.mjs --write",
    "sanity:seed:home-sanity": "node scripts/seed-home-sanity-landing.mjs --write",
